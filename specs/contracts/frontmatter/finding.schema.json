{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontmatter/finding.schema.json",
  "title": "Finding frontmatter",
  "description": "Seed shape of a finding document. supersedes may be null. Evidence links are not pinned. maxLength counts Unicode code points.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "status", "confidence", "evidence"],
  "properties": {
    "type": { "const": "finding" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "enum": ["current", "superseded", "disputed"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[a-z0-9]+(?:-[a-z0-9]+)*(?:@[1-9][0-9]{0,8})?(?:#[^\\]\\r\\n]{1,200})?\\]\\]$"
      }
    },
    "supersedes": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "string",
          "pattern": "^\\[\\[[a-z0-9]+(?:-[a-z0-9]+)*(?:@[1-9][0-9]{0,8})?(?:#[^\\]\\r\\n]{1,200})?\\]\\]$"
        }
      ]
    }
  },
  "x-ledger": {
    "folder": "findings",
    "filename": "{slug}",
    "sections": ["Claim", "Evidence summary", "Caveats"]
  },
  "examples": [
    {
      "type": "finding",
      "title": "Summaries degrade past 30 journal turns",
      "status": "current",
      "confidence": "medium",
      "evidence": ["[[2026-09-22-context-window-8k]]", "[[2026-09-18-long-session-stress]]"],
      "supersedes": null
    }
  ]
}
