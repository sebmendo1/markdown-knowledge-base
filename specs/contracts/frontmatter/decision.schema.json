{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontmatter/decision.schema.json",
  "title": "Decision frontmatter",
  "description": "Seed shape of a decision document. based_on links are not pinned. results_in is an optional pinned harness link. maxLength counts Unicode code points.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "date", "status", "based_on"],
  "properties": {
    "type": { "const": "decision" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status": { "enum": ["proposed", "accepted", "reversed"] },
    "based_on": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^\\[\\[[a-z0-9]+(?:-[a-z0-9]+)*(?:@[1-9][0-9]{0,8})?(?:#[^\\]\\r\\n]{1,200})?\\]\\]$"
      }
    },
    "results_in": { "type": "string", "pattern": "^\\[\\[[a-z0-9]+(?:-[a-z0-9]+)*@[1-9][0-9]{0,8}(?:#[^\\]\\r\\n]{1,200})?\\]\\]$" }
  },
  "x-ledger": {
    "folder": "decisions",
    "filename": "{slug}",
    "sections": ["Decision", "Why", "Alternatives considered", "Revisit when"]
  },
  "examples": [
    {
      "type": "decision",
      "title": "Ship harness v7 for App Store launch",
      "date": "2026-09-24",
      "status": "accepted",
      "based_on": ["[[summaries-degrade-long-context]]"],
      "results_in": "[[memento-journal@7]]"
    }
  ]
}
