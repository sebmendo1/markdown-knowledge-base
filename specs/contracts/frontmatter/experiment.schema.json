{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontmatter/experiment.schema.json",
  "title": "Experiment frontmatter",
  "description": "Seed shape of an experiment document. verdict is required when status is concluded (required_when). results keys are checked against the linked eval by the validator, not by this schema. maxLength counts Unicode code points.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "date", "status", "hypothesis", "harness", "eval"],
  "properties": {
    "type": { "const": "experiment" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status": { "enum": ["planned", "running", "concluded", "abandoned"] },
    "hypothesis": { "type": "string", "minLength": 1 },
    "harness": { "type": "string", "pattern": "^\\[\\[[a-z0-9]+(?:-[a-z0-9]+)*@[1-9][0-9]{0,8}(?:#[^\\]\\r\\n]{1,200})?\\]\\]$" },
    "eval": { "type": "string", "pattern": "^\\[\\[[a-z0-9]+(?:-[a-z0-9]+)*@[1-9][0-9]{0,8}(?:#[^\\]\\r\\n]{1,200})?\\]\\]$" },
    "environment": { "type": "string" },
    "sample_size": { "type": "number", "minimum": 1 },
    "results": {
      "type": "object",
      "additionalProperties": { "type": "number" },
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "verdict": { "enum": ["supported", "refuted", "inconclusive"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "concluded" } },
        "required": ["status"]
      },
      "then": {
        "required": ["verdict"],
        "properties": {
          "verdict": { "enum": ["supported", "refuted", "inconclusive"] }
        }
      }
    }
  ],
  "x-ledger": {
    "folder": "experiments",
    "filename": "{date}-{slug}",
    "sections": ["Setup", "Observations", "Surprises", "Next"]
  },
  "examples": [
    {
      "type": "experiment",
      "title": "Context window 8k vs 4k",
      "date": "2026-09-22",
      "status": "concluded",
      "hypothesis": "An 8k rolling window improves faithfulness without doubling latency",
      "harness": "[[memento-journal@7]]",
      "eval": "[[summary-faithfulness@2]]",
      "environment": "iPhone 16 Pro, iOS 27.0",
      "sample_size": 40,
      "results": { "faithfulness": 0.82, "latency_ms": 420 },
      "verdict": "supported"
    }
  ]
}
